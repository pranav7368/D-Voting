# Registration Authority configuration.
# Copy to .env and fill in. NEVER commit the filled-in file.

NODE_ENV=development
PORT=8081

# The election this Registration Authority issues credentials for.
ELECTION_ID=election-2026-demo

# Issuer RSA private key as a JWK, on a single line.
# Generate with:  npm run registration:keygen > issuer.key.json
# In production this belongs in a secrets manager, and ideally the signing
# operation moves into KMS/HSM so the key has no plaintext form at all.
ISSUER_PRIVATE_KEY_JWK={"kty":"RSA","n":"...","e":"AQAB","d":"...","p":"...","q":"...","dp":"...","dq":"...","qi":"..."}

# HMAC pepper for identity hashing. Min 32 chars. Must live outside the database
# -- it is what stops a database dump from revealing who registered.
# Generate with:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
IDENTITY_PEPPER=CHANGE_ME_generate_32_plus_random_bytes

# HMAC key for short-lived registration tokens. Min 32 chars.
REGISTRATION_TOKEN_SECRET=CHANGE_ME_generate_32_plus_random_bytes

# Registration token lifetime in seconds (60-3600).
REGISTRATION_TOKEN_TTL_SECONDS=900

# Storage. Use "postgres" for anything real; "memory" is for tests/offline demo
# and is refused outright when NODE_ENV=production.
STORAGE_DRIVER=postgres
DATABASE_URL=postgres://dvoting:dvoting_dev_only@localhost:5433/dvoting

# Eligibility comes from the built-in electoral roll. Import it with:
#   npm run roll:import --workspace @dvoting/registration-authority -- roll.txt
# IDENTITY_PEPPER above also keys the enrolment-code HMACs (domain-separated),
# so rotating it invalidates every issued polling card.

# Enables the roll administration routes (/v1/admin/roll): enrol, revoke, freeze,
# export. Min 32 chars. LEAVE IT UNSET unless you need them -- a route that can
# add voters should not exist unless it was asked for. This is deliberately NOT
# the ballot box's admin token: they are separate authorities, and one token for
# both would merge the two halves of the picture that must stay apart.
# ADMIN_TOKEN=CHANGE_ME_generate_32_plus_random_bytes

# Strict CORS allow-list, comma separated. Empty means same-origin only.
CORS_ALLOWED_ORIGINS=

# Per-IP rate limiting.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# Only set true when actually behind a trusted reverse proxy. If this is true
# and the service is directly reachable, any client can forge its source IP via
# X-Forwarded-For and bypass rate limiting entirely.
TRUST_PROXY=false
